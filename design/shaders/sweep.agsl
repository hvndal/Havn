// Hävn — S-02 Sweep
// The seamless studio backdrop behind the capsule: wall colour easing into the
// cove and out to the floor, a soft pool of light, a slight corner falloff.
// Use it as the background brush of Today, Capsule and Dose.
//
// Uniforms
//   size       draw size in px
//   wall       top colour (Sweep high)
//   cove       where wall meets floor (Sweep mid)
//   floorColor bottom edge (Sweep low)
//   horizon    0–1, where the cove sits: 0.62 on Today, 0.78 on Capsule
//   pool       0–1, centre of the light pool
//   poolGain   0.10

uniform float2 size;
layout(color) uniform half4 wall;
layout(color) uniform half4 cove;
layout(color) uniform half4 floorColor;
uniform float horizon;
uniform float2 pool;
uniform float poolGain;

half4 main(float2 fragCoord) {
    float2 uv = fragCoord / size;                      // y runs down
    float aspect = size.x / size.y;
    half3 c = uv.y < horizon
        ? mix(wall.rgb, cove.rgb, half(smoothstep(0.0, horizon, uv.y)))
        : mix(cove.rgb, floorColor.rgb, half(smoothstep(horizon, 1.0, uv.y)));
    float2 d = (uv - pool) * float2(aspect, 1.0);
    c *= half(1.0 + poolGain * exp(-dot(d, d) * 3.0));
    float2 v = uv - 0.5;
    c *= half(1.0 - 0.16 * pow(dot(v, v) * 2.0, 1.4));
    return half4(c, 1.0);
}
