<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <attribution
        android:tag="default"
        android:label="@string/app_name" />

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!--
      Removed: INTERNET, SCHEDULE_EXACT_ALARM, USE_EXACT_ALARM.

      • INTERNET was needed only because the 3D organizer loaded three.js from a
        CDN, which also meant the app's signature screen silently failed to
        render offline. three.js is now bundled in assets, so Hävn requests no
        network access at all — which matches what it tells users on the
        onboarding screen ("everything stays on this device").

      • The exact-alarm permissions were never exercised: reminders are
        scheduled through WorkManager, and AlarmManager is touched only to
        cancel alarms left behind by older installs, which needs no permission.
        Both are restricted permissions that draw Play Store review, so
        declaring them unused was a liability.
    -->

    <application
        android:name=".HavnApplication"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Havn"
        android:hardwareAccelerated="true">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="uiMode|orientation|screenSize|screenLayout|keyboardHidden|density|fontScale|smallestScreenSize"
            android:theme="@style/Theme.Havn.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Hands a single export file to the share sheet. Scoped to the
             exports cache folder only (res/xml/file_paths.xml). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- WorkManager is initialised on demand via HavnApplication -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <receiver
            android:name=".notifications.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Handles "Mark taken" and "In 15 min" from a reminder notification -->
        <receiver
            android:name=".notifications.AlarmReceiver"
            android:exported="false" />

        <receiver
            android:name=".widget.HavnWidgetReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/havn_widget_info" />
        </receiver>

    </application>

</manifest>
