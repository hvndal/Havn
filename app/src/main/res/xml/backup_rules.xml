<?xml version="1.0" encoding="utf-8"?>
<!--
  Android Auto Backup (API 23–30).

  Deliberately left ON. Hävn stores medication history in exactly one place, so
  having Android restore it automatically after a lost or replaced phone is the
  single biggest thing protecting the user's data — more reliable than hoping
  they remembered to export.

  An explicit <include> list is allow-list semantics: anything not named here is
  already excluded, so the export cache never leaves the device. (It sits in
  cacheDir, which Auto Backup skips regardless.)
-->
<full-backup-content>
    <include domain="database" path="." />
    <include domain="sharedpref" path="." />
</full-backup-content>
