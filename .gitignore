*.keystore
*.jks
*.p12
*.pfx
keystore.properties

# API keys and service credentials.
.env
.env.*
!.env.example
secrets.properties
google-services.json
service-account*.json
*.pem
*.key

# ── IDE / OS ─────────────────────────────────────────────────────────────────
.idea/
*.iml
.DS_Store
Thumbs.db

