            "value": "Tous les médicaments et toutes les prises seront supprimés de cet iPhone. Cette action est irréversible."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Se eliminarán todos los medicamentos y tomas de este iPhone. No se puede deshacer."
