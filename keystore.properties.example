# Copy to keystore.properties (gitignored) to sign a release build locally.
# On CI, set HAVN_KEYSTORE / HAVN_KEYSTORE_PASSWORD / HAVN_KEY_ALIAS /
# HAVN_KEY_PASSWORD as secrets instead — never commit the real file.
#
# Without either, `assembleRelease` produces an UNSIGNED apk. That is
# deliberate: the alternative is silently signing with a well-known debug key.
storeFile=/absolute/path/to/havn-release.jks
storePassword=
keyAlias=havn
keyPassword=
